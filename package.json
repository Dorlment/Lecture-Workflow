{
	"name": "lecture-workflow",
	"version": "1.0.0",
	"description": "将课堂文字稿、笔记和截图整理成结构化学习笔记，并保存回 Obsidian。",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test tests/*.test.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"stage:audio-companion": "node companion/windows/scripts/stage-audio-companion.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin"
	],
	"author": "Dorlment",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
